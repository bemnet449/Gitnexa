# AI API key (required for commit generation and explain)
# Google Gemini: https://aistudio.google.com/apikey
# OpenRouter:   https://openrouter.ai/keys
GEMINI_API_KEY=your_api_key_here

# Model name
# Gemini example: gemini-2.0-flash
# OpenRouter example: openrouter/free
GEMINI_MODEL=openrouter/free

# Optional: force OpenRouter even with a non-sk-or key
# AI_PROVIDER=openrouter
